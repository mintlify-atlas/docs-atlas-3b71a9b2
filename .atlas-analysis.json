  "keyFeatures": [
    "Cross-platform support for all UNIX and Windows terminals (down to Windows 7)",
    "Command API with lazy (queue) and direct (execute) execution modes",
    "Cursor control: movement, visibility, blinking, position save/restore",
    "Styled terminal output: 16/256/RGB colors, bold, italic, underline and other attributes",
    "Input event system: keyboard, mouse, focus, resize, and paste events",
    "Raw mode and alternate screen buffer management",
    "Async event stream support via `event-stream` feature (Tokio/smol compatible)",
    "OSC52 clipboard copy support via `osc52` feature",
    "Synchronized terminal updates to prevent screen tearing",
    "Serde support for types via `serde` feature flag"
  ],
  "publicApiSurface": [
    "trait Command",
    "trait QueueableCommand (.queue())",
    "trait ExecutableCommand (.execute())",
    "trait SynchronizedUpdate (.sync_update())",
    "macro execute!",
    "macro queue!",
    "cursor::MoveTo, MoveUp, MoveDown, MoveLeft, MoveRight",
    "cursor::MoveToNextLine, MoveToPreviousLine, MoveToColumn, MoveToRow",
    "cursor::SavePosition, RestorePosition",
    "cursor::Show, Hide",
    "cursor::EnableBlinking, DisableBlinking",
    "cursor::SetCursorStyle",
    "cursor::position()",
    "style::SetForegroundColor, SetBackgroundColor, SetUnderlineColor, SetColors",
    "style::SetAttribute, SetAttributes, SetStyle",
    "style::PrintStyledContent, Print, ResetColor",
    "style::StartHyperlink, EndHyperlink",
    "style::Stylize trait",
    "style::Color, Attribute, Attributes, ContentStyle, StyledContent",
    "style::available_color_count(), force_color_output()",
    "event::read(), poll(), try_read()",
    "event::EventStream (async, feature = event-stream)",
    "event::Event, KeyEvent, MouseEvent, KeyCode, KeyModifiers",
    "event::EnableMouseCapture, DisableMouseCapture",
    "event::EnableFocusChange, DisableFocusChange",
    "event::EnableBracketedPaste, DisableBracketedPaste",
    "event::PushKeyboardEnhancementFlags, PopKeyboardEnhancementFlags",
    "terminal::enable_raw_mode(), disable_raw_mode(), is_raw_mode_enabled()",
    "terminal::size(), window_size()",
    "terminal::EnterAlternateScreen, LeaveAlternateScreen",
    "terminal::EnableAlternateScrollMode, DisableAlternateScrollMode",
    "terminal::Clear, ScrollUp, ScrollDown, SetSize, SetTitle",
    "terminal::EnableLineWrap, DisableLineWrap",
    "terminal::supports_keyboard_enhancement()",
    "clipboard::CopyToClipboard",
    "clipboard::ClipboardType, ClipboardSelection",
    "ansi_support::supports_ansi() (Windows only)"
  ]
