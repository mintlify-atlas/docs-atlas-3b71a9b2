{
  "projectType": "sdk-library",
  "projectName": "Crossterm",
  "projectDescription": "A pure-Rust, cross-platform terminal manipulation library for building text-based interfaces with cursor control, styled output, input events, and terminal management.",
  "theme": "luma",
  "primaryColor": "#000000",
  "lightColor": "#012169",
  "darkColor": "#41b1f8",
